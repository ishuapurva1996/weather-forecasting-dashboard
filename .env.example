# Private Airflow handoff configuration. Never commit .env.
DASHBOARD_S3_BUCKET=your-existing-private-bucket
DASHBOARD_S3_PREFIX=dashboard/weather-v1
DASHBOARD_AWS_REGION=us-west-1
DASHBOARD_GITHUB_TOKEN=weather-repository-scoped-actions-dispatch-token
DASHBOARD_AIRFLOW_USERNAME=existing-weather-metadata-reader
DASHBOARD_AIRFLOW_PASSWORD=private-reader-password
AWS_CREDENTIALS_DIR=/absolute/path/to/.aws
AIRFLOW_UID=50000
